# Скопируй в .env:  cp .env.example .env
# Значения по умолчанию рассчитаны на локальную разработку. Для любого
# общедоступного стенда смени пароли и JWT_SECRET_KEY.

# ---------- Сервис ----------
SERVICE_NAME=lit-tracker
SERVICE_VERSION=1.0.0
# development | staging | production | test
SERVICE_ENV=development
DEBUG=True
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8001
RELOAD=True

# ---------- PostgreSQL ----------
# Эти три переменные использует docker compose (создаёт БД и собирает DATABASE_URL для контейнеров)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lit_tracker

# Для запуска приложения на хосте, без Docker (порт 5433 — проброшен из compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/lit_tracker
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=False

# ---------- Redis ----------
# Для запуска на хосте (порт 6380 — проброшен из compose); в контейнерах compose задаёт адрес сам
REDIS_URL=redis://localhost:6380/0
CACHE_TTL_SECONDS=3600

# ---------- JWT ----------
# Минимум 32 символа. Сгенерировать: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-32-characters-or-more
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Ollama (LLM и эмбеддинги) ----------
# Docker compose: Ollama на хосте -> http://host.docker.internal:11434
# Ollama на другой машине -> http://<ip-машины>:11434
# Приложение на хосте без Docker -> http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Должна совпадать с размерностью модели эмбеддингов (nomic-embed-text = 768)
EMBEDDING_DIMENSION=768

# ---------- Анализ вкуса (LangGraph) ----------
TASTE_MAX_RETRIES=3
TASTE_RETRY_BACKOFF_SECONDS=1.0
# Анализ без движения дольше N секунд считается зависшим и продолжается с чекпоинта.
# Должно быть больше таймаута одного вызова LLM (180 с).
TASTE_STALE_AFTER_SECONDS=300
TASTE_RECOVERY_INTERVAL_SECONDS=60

# ---------- Безопасность ----------
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
